# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql://paragraf:paragraf@localhost:5434/paragraf

# --- Providers (fake = deterministic offline provider for tests/CI) ---
LLM_PROVIDER=openai            # openai | gemini | fake
LLM_MODEL=gpt-5.4-mini         # answers, planner, query rewrite
LLM_THINKING=none              # reasoning effort: none | minimal | low | medium | high
JUDGE_MODEL=gpt-5.4-nano       # citation judge (separate prompt, sees only provision + claim)
JUDGE_THINKING=low
EMBEDDING_PROVIDER=jina      # jina | gemini | fake
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIM=768
RERANKER_PROVIDER=jina         # jina | llm | none | fake
RERANKER_MODEL=jina-reranker-v2-base-multilingual

OPENAI_API_KEY=
JINA_API_KEY=

# --- Demo protection (cached answers are free and count against none of these) ---
RATE_LIMIT_PER_MINUTE=6        # new questions per client IP per minute
RATE_LIMIT_PER_DAY=40          # new questions per client IP per UTC day
DAILY_REQUEST_BUDGET=300       # new questions per UTC day for all users together
MAX_CONCURRENT_REQUESTS=4      # agent runs in flight; more get a "busy" reply
MAX_QUERY_CHARS=500
CORS_ORIGINS=http://localhost:5173   # production: the frontend URL, e.g. https://paragraf.vercel.app
TRUSTED_PROXY_HOPS=0           # production behind one proxy (Render, Railway, Fly): 1
ENABLE_API_DOCS=false          # /docs and /openapi.json
