# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql://paragraf:paragraf@localhost:5434/paragraf

# --- Providers (fake = deterministic offline provider for tests/CI) ---
LLM_PROVIDER=gemini            # gemini | fake
LLM_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini      # gemini | fake
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
RERANKER_PROVIDER=jina         # jina | cohere | none | fake
RERANKER_MODEL=jina-reranker-v2-base-multilingual

GEMINI_API_KEY=
JINA_API_KEY=
COHERE_API_KEY=

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Demo protection ---
RATE_LIMIT_PER_MINUTE=6
DAILY_REQUEST_BUDGET=300
MAX_QUERY_CHARS=500
CORS_ORIGINS=http://localhost:5173
